# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://sasyamai_user:YOUR_PASSWORD@localhost:5432/sasyamai

# Security & JWT Authentication
JWT_SECRET_KEY=sasyamai-super-secret-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenAI API (ChatGPT & Vision Model)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
MAX_OUTPUT_TOKEN=800

# Sarvam AI (Saaras v3 STT + Bulbul TTS for Indian Languages)
SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech

# ImgBB API (Image Hosting for Profile Pictures and Disease Scans)
IMGBB_API_KEY=your-imgbb-api-key-here
IMGBB_UPLOAD_URL=https://api.imgbb.com/1/upload

# Application Configuration
APP_NAME=SasyamAI
ENVIRONMENT=development
DEBUG=true